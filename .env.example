# Copy to .env.local. Locally, `pnpm env:local` writes it for you from `supabase status`.

# --- Browser + server (public) ---
# Local: http://127.0.0.1:54321. Cloud: Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: the publishable key printed by `pnpm exec supabase status`. Cloud: Project Settings → API Keys → Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute URL of this app, used for auth redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Scripts only (seed, make-admin, tests). Never expose to the browser. ---
# Local: postgresql://postgres:postgres@127.0.0.1:54322/postgres. Cloud: Project Settings → Database → Connection string (session pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Local Mailpit (catches sign-in emails). Used by the Playwright smoke test.
MAILPIT_URL=http://127.0.0.1:54324
